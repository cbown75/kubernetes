{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "commitMessageAction": "update",
  "kubernetes": {
    "managerFilePatterns": ["apps/.+\\.yaml$", "infrastructure/.+\\.yaml$"]
  },
  "packageRules": [
    {
      "description": "Upgrade Flux by regenerating gotk-components.yaml, never by tag bumps (BOW-772)",
      "matchFileNames": ["clusters/korriban/flux-system/gotk-components.yaml"],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "groupName": "immich"
    },
    {
      "description": "OnCall's celery needs RabbitMQ's transient_nonexcl_queues permit; a new release can remove it (BOW-763)",
      "matchPackageNames": ["docker.io/rabbitmq"],
      "separateMinorPatch": true,
      "prBodyNotes": ["Before merging, run `rabbitmqctl list_deprecated_features` on the new version: `transient_nonexcl_queues` must not be `removed`, or oncall-celery crash-loops (BOW-763)."]
    },
    {
      "matchPackageNames": ["docker.io/rabbitmq"],
      "matchUpdateTypes": ["minor", "major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": ["ghcr.io/immich-app/immich-machine-learning"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-cuda$"
    }
  ]
}
